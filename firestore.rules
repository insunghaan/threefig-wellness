rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all client-side reads and writes across all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Waitlist signups:
    // Stored and queried strictly server-side via Google Cloud SDK / Server Actions.
    // Direct client-side writes and reads are completely forbidden.
    match /waitlist_signups/{signupId} {
      allow read, write: if false;
    }
  }
}
